{
  "name": "qa-automation-challenge-e2e",
  "version": "1.0.0",
  "description": "Automatización E2E con Cypress para SauceDemo — QA Automation Challenge",
  "author": "Kelin Ferrera",
  "scripts": {
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:chrome": "cypress run --browser chrome",
    "test:report": "cypress run && npm run report:merge && npm run report:generate",
    "report:merge": "mochawesome-merge cypress/reports/*.json > cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json --reportDir cypress/reports --inline",
    "open": "cypress open"
  },
  "devDependencies": {
    "cypress": "^12.17.4",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
